use miden::protocol::native_account
use miden::protocol::active_account

use miden::core::word
use miden::core::sys

use miden::core::math::u256


const RESERVE_SLOT = word("zoro::c_prod_pool::reserve")

#! Inputs:  []
#! Outputs: [asset0_reserve, asset1_reserve ]
pub proc get_reserve
    push.RESERVE_SLOT[0..2] exec.active_account::get_item
    # => [ asset0_reserve, asset1_reserve ]

    exec.sys::truncate_stack
    # => [ asset0_reserve, asset1_reserve ]
end