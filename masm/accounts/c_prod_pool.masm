use miden::protocol::native_account
use miden::protocol::active_account
use miden::protocol::active_note
use miden::protocol::output_note
use miden::protocol::asset

#use miden::core::word
use miden::core::sys

use miden::core::math::u256
use miden::core::math::u64

const RESERVE_SLOT = word("zoro::c_prod_pool::reserve")
const CONFIG_SLOT = word("zoro::c_prod_pool::config")
const LP_SHARES_SLOT = word("zoro::c_prod_pool::lp_shares")

const MINIMUM_LIQUIDITY = 1000

const ERR_INSUFFICIENT_LP_MINTED = "Insufficient LP minted"
const ERR_SQRT_VERIFY_FAIL = "Sqrt verify fail"
const ERR_DIV_VERIFY_FAIL = "Div verify fail"
const ERR_INSUFFICIENT_OUTPUT = "Insufficient output"
const ERR_INSUFFICIENT_LP_BALANCE = "Insufficient LP balance"
const ERR_ZERO_AMOUNT = "Zero amount"


@locals(4)
pub proc get_amount_out_naive(reserve_in: u32, reserve_out: u32, amount_in: u32) -> u32
    # loc.0: reserve_in
    # loc.1: reserve_out
    # loc.2: amount_in
    loc_store.0  loc_store.1 loc_store.2
    
    # amount_in_with_fee = amount_in * 997 scaled by 1000
    loc_load.2 push.997 mul
    # => [amount_in_with_fee]
    # loc.3: amount_in_with_fee
    loc_store.3
    # => []
    # numerator = amount_in_with_fee * reserve_out
    loc_load.3 loc_load.1 mul
    # => [numerator]
    # denominator = reserve_in * 1000 + amount_in_with_fee
    loc_load.3 mul.1000 loc_load.0 add
    # => [denominator, numerator]
    #  amount_out = numerator / denominator
    div
    # => [amount_out]
    exec.sys::truncate_stack
end


# =============================================================================================
# INTERNAL HELPERS
# =============================================================================================

#! Reads the reserve storage slot.
#! Outputs: [reserve0, reserve1, total_lp, 0]
proc read_reserves
    push.RESERVE_SLOT[0..2] exec.active_account::get_item
end

#! Reads the config storage slot.
#! Outputs: [t0_prefix, t0_suffix, t1_prefix, t1_suffix]
proc read_config
    push.CONFIG_SLOT[0..2] exec.active_account::get_item
end

#! Writes reserves back to storage.
#! Inputs: [reserve0, reserve1, total_lp, 0]
proc write_reserves
    push.RESERVE_SLOT[0..2] exec.native_account::set_item
    dropw
end

